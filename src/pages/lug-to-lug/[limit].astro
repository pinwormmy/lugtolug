---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GuideListSearch from "@/components/GuideListSearch";
import { getDb, listCatalogWatches } from "@/lib/db";
import { resolveOrigin } from "@/lib/seo";
import { buildFaqSchema } from "@/lib/watchWearability";
import {
  LUG_TO_LUG_LIMITS,
  WRIST_SIZES,
  classifyFit,
  countByBrand,
  getLugToLugLimit,
  getLugToLugLimitHref,
  getWristGuideHref,
  type WristFitBand
} from "@/lib/wristGuide";
import { uniqueByModel } from "@/lib/guideList";
import { buildItemListSchema, describeLugToLugLimit } from "@/lib/wristGuideCopy";

const limit = getLugToLugLimit(Astro.params.limit!);

if (!limit) {
  return Astro.rewrite("/404");
}

const watches = await listCatalogWatches(getDb(Astro.locals));
const under = watches.filter((watch) => watch.lugToLugMm <= limit.maxMm);
const topBrands = countByBrand(under, 12);
const brandCount = new Set(under.map((watch) => watch.brandSlug)).size;
const copy = describeLugToLugLimit(limit, { count: under.length, brandCount, topBrands });
const newest = uniqueByModel([...under].sort((a, b) => b.id - a.id), 48);
const BAND_LABELS: Record<WristFitBand, string> = {
  compact: "Compact",
  balanced: "Balanced",
  large: "Large",
  borderline: "Borderline",
  overhang: "Overhang"
};
const wristFit = WRIST_SIZES.map((size) => ({ size, band: classifyFit(limit.maxMm, size) }));
const searchHref = `/?lugToLugMmMax=${limit.maxMm}&sort=lug-asc`;
const origin = resolveOrigin(Astro.site);
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { name: "Wrist size guide", item: new URL("/wrist", origin).toString() },
    { name: copy.heading, item: new URL(Astro.url.pathname, origin).toString() }
  ].map((crumb, index) => ({ "@type": "ListItem", position: index + 1, ...crumb }))
};
---

<BaseLayout title={copy.title} description={copy.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(buildFaqSchema(copy.faq))} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(buildItemListSchema(origin, newest))} />

  <section class="section" style="margin-top: 0;">
    <nav class="detail-breadcrumb" aria-label="Breadcrumb">
      <a href="/wrist">Wrist size guide</a>
    </nav>
    <h1 class="page-title">{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>
  </section>

  <section class="section grid-2">
    <div class="panel">
      <p class="eyebrow">By wrist</p>
      <h2>How a {limit.maxMm} mm span wears</h2>
      <table class="fit-bands guide-table">
        <thead>
          <tr><th>Wrist</th><th>Fit at {limit.maxMm} mm</th></tr>
        </thead>
        <tbody>
          {wristFit.map(({ size, band }) => (
            <tr class:list={[{ "is-current": band === "balanced" }]}>
              <td><a href={getWristGuideHref(size)}>{size.label}</a></td>
              <td>{BAND_LABELS[band]}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="small">Every watch on this page is at or under {limit.maxMm} mm, so the smaller wrists above get the widest choice.</p>
    </div>
    <div class="panel">
      <p class="eyebrow">Brands</p>
      <h2>Most options under {limit.maxMm} mm</h2>
      <div class="brand-directory-grid">
        {topBrands.map((brand) => (
          <a href={`/brands/${brand.brandSlug}`}>
            <strong>{brand.brand}</strong>
            <span>{brand.count.toLocaleString("en-US")}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section related-watches" aria-labelledby="newest-title">
    <div class="related-watches-heading">
      <div>
        <p class="eyebrow">Recently added</p>
        <h2 id="newest-title">Newest watches under {limit.maxMm} mm lug-to-lug</h2>
      </div>
      <p>One entry per model family. <a href={searchHref}>Open all {under.length.toLocaleString("en-US")} in search</a>, sorted shortest first.</p>
    </div>
    <GuideListSearch client:load initialWatches={newest} totalCount={under.length} maxMm={limit.maxMm} sort="newest" noun="watches" />
  </section>

  <section class="section panel wearability" aria-labelledby="limit-faq-title">
    <p class="eyebrow">Questions</p>
    <h2 id="limit-faq-title">Under {limit.maxMm} mm lug-to-lug</h2>
    {copy.faq.map((entry) => (
      <>
        <h3>{entry.question}</h3>
        <p>{entry.answer}</p>
      </>
    ))}
  </section>

  <section class="section panel" aria-label="Other guides">
    <p class="eyebrow">Other ceilings</p>
    <div class="guide-chips">
      {LUG_TO_LUG_LIMITS.map((entry) => (
        <a href={getLugToLugLimitHref(entry)} aria-current={entry.slug === limit.slug ? "page" : undefined}>{entry.label}</a>
      ))}
    </div>
    <p class="eyebrow" style="margin-top: 16px;">By wrist size</p>
    <div class="guide-chips">
      {WRIST_SIZES.map((size) => <a href={getWristGuideHref(size)}>{size.label}</a>)}
    </div>
  </section>
</BaseLayout>
