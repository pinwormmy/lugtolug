---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CorrectionReportForm from "@/components/CorrectionReportForm";
import FitCalculator from "@/components/FitCalculator";
import WatchRow from "@/components/WatchRow.astro";
import { getAdminSession } from "@/lib/auth";
import { getManagePublishedWatchHref } from "@/lib/adminRoutes";
import { getDb, getWatchBySlugs, listSimilarWatches } from "@/lib/db";
import { mmToInches } from "@/lib/fit";
import { resolveWatchOgImage } from "@/lib/ogImage";
import { formatMm, getWatchDisplayModel, getWatchDisplayName, isHttpUrl, WATCH_METRICS } from "@/lib/watch";
import { resolveOrigin } from "@/lib/seo";
import { buildFaqSchema, describeWearability } from "@/lib/watchWearability";

const { brand, model, reference } = Astro.params;
const db = getDb(Astro.locals);
const watch = await getWatchBySlugs(db, brand!, model!, reference!);

if (!watch) {
  return Astro.rewrite("/404");
}

const [adminSession, similarWatches] = await Promise.all([
  getAdminSession(db, Astro.request),
  listSimilarWatches(db, watch, 6)
]);
const manageHref = getManagePublishedWatchHref(watch);
const watchModel = getWatchDisplayModel(watch);
const watchName = getWatchDisplayName(watch);
const referenceLabel = watch.reference || "Reference not provided";
const variantLabel = watch.variant ? `${referenceLabel} · ${watch.variant}` : referenceLabel;
const wearability = describeWearability(watch);
const formatInches = (value: number | null | undefined) => value == null ? "Not provided" : `${mmToInches(value).toFixed(2)} in`;
const titleIdentity = [watch.brand, watchModel, watch.reference].filter(Boolean).join(" ");
const title = `${titleIdentity} lug-to-lug, dimensions & wrist fit`;
const description = `${watchName} ${referenceLabel} dimensions: ${formatMm(watch.lugToLugMm)} lug-to-lug, ${formatMm(watch.caseMm)} case, ${formatMm(watch.thicknessMm)} thickness, and ${formatMm(watch.lugWidthMm)} lug width. ${wearability.copy.headline}. Check wrist fit and cited sources.`;
const siteOrigin = resolveOrigin(Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: watchName,
  description,
  url: canonicalUrl,
  ...(watch.brand ? { brand: { "@type": "Brand", name: watch.brand } } : {}),
  ...(watch.reference ? { model: watch.reference } : {}),
  additionalProperty: WATCH_METRICS.flatMap((metric) => {
    const value = watch[metric.key];
    return value == null
      ? []
      : [{ "@type": "PropertyValue", name: metric.detailLabel, value, unitText: "mm" }];
  })
};
const faqData = buildFaqSchema(wearability.copy.faq);
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { name: "Watches", item: new URL("/watches", siteOrigin).toString() },
    ...(watch.brand ? [{ name: watch.brand, item: new URL(`/brands/${watch.brandSlug}`, siteOrigin).toString() }] : []),
    { name: watchName, item: canonicalUrl }
  ].map((crumb, index) => ({ "@type": "ListItem", position: index + 1, ...crumb }))
};
---

<BaseLayout title={title} description={description} image={resolveWatchOgImage(watch)}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqData)} />
  <section class="section detail-record" style="margin-top: 0;">
    <div>
      <nav class="detail-breadcrumb" aria-label="Breadcrumb">
        <a href="/watches">Watch database</a>
        {watch.brand && (
          <>
            <span aria-hidden="true">/</span>
            <a href={`/brands/${watch.brandSlug}`}>{watch.brand}</a>
          </>
        )}
      </nav>
      <h1 class="page-title">{watchModel}</h1>
      <p class="lede">{variantLabel}</p>
    </div>
  </section>

  <section class="section spec-grid">
    {WATCH_METRICS.map((metric) => (
      <div class="spec-card">
        <span>{metric.detailLabel}</span>
        <strong>{formatMm(watch[metric.key])}</strong>
        <span>{formatInches(watch[metric.key])}</span>
      </div>
    ))}
  </section>

  <section class="section panel wearability" aria-labelledby="wearability-title">
    <p class="eyebrow">How it wears</p>
    <h2 id="wearability-title">{wearability.copy.headline}</h2>
    {wearability.copy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="section grid-2">
    <FitCalculator client:load lugToLugMm={watch.lugToLugMm} compareWatch={{ brandSlug: watch.brandSlug, modelSlug: watch.modelSlug, referenceSlug: watch.referenceSlug }} />
    <div class="panel" id="sources">
      <h2>Sources</h2>
      <ul>
        {watch.sources.map((source) => (
          <li>
            {isHttpUrl(source.sourceUrl) ? (
              <a href={source.sourceUrl} rel="nofollow noreferrer" target="_blank">{source.sourceUrl}</a>
            ) : source.sourceUrl}
            {source.note && <p class="small">{source.note}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {similarWatches.length > 0 && (
    <section class="section related-watches" aria-labelledby="related-watches-title">
      <div class="related-watches-heading">
        <div>
          <p class="eyebrow">Compare</p>
          <h2 id="related-watches-title">Similar dimensions</h2>
        </div>
        <p>Nearby lug-to-lug and case measurements, excluding variants from this model family.</p>
      </div>
      <div class="related-watch-grid">
        {similarWatches.map((similarWatch) => <WatchRow watch={similarWatch} />)}
      </div>
    </section>
  )}

  <section class="section" id="notes">
    <CorrectionReportForm client:load watch={watch} />
  </section>

  {adminSession && (
    <section class="section" style="padding-top: 0;">
      <p style="margin: 0;">
        <a class="button secondary" href={manageHref}>Manage published data</a>
      </p>
    </section>
  )}
</BaseLayout>
