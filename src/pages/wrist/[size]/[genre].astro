---
import WristGuidePage from "@/components/WristGuidePage.astro";
import { getDb, listCatalogWatches } from "@/lib/db";
import { buildWristGuide, getWatchGenre, getWristSize } from "@/lib/wristGuide";

const size = getWristSize(Astro.params.size!);
const genre = getWatchGenre(Astro.params.genre!);

if (!size || !genre) {
  return Astro.rewrite("/404");
}

const guide = buildWristGuide(await listCatalogWatches(getDb(Astro.locals)), size, genre);
---

<WristGuidePage guide={guide} />
